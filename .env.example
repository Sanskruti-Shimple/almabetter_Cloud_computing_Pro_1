APP_ENV=development
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC=music-events
KAFKA_DLQ_TOPIC=music-events-dlq
REDIS_URL=redis://redis:6379/0
API_READ_TOKEN=replace-with-a-random-read-token-of-at-least-32-characters
API_WRITE_TOKEN=replace-with-a-random-write-token-of-at-least-32-characters
PII_HMAC_KEY=replace-with-a-random-secret-of-at-least-32-characters
ARCHIVE_DIR=/app/data/events
RECOMMENDATION_LIMIT=10
EVENTHUB_NAMESPACE=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=music-events
